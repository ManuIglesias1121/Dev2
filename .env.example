# .env.example - VARIABLES DE SEGURIDAD Y LEGAL
# COPIAR A .env Y COMPLETAR CON VALORES REALES
# NUNCA commitear .env al repositorio

# ============================================
# AMBIENTE
# ============================================
NODE_ENV=production
APP_NAME=Therianthrope Dating
APP_VERSION=2.0.0

# ============================================
# SEGURIDAD - CRIPTOGRAFÍA
# ============================================

# JWT para autenticación
# GENERAR: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-32-characters-minimum
JWT_EXPIRES_IN=7d

# Refresh token para renovación sin re-login
REFRESH_TOKEN_SECRET=your-refresh-token-secret-32-characters-minimum
REFRESH_TOKEN_EXPIRES_IN=30d

# Base de datos - Encriptación de campos sensibles
# GENERAR: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_ENCRYPTION_KEY=your-database-encryption-key-for-aes256
DATABASE_ENCRYPTION_IV=your-database-encryption-iv

# API Key para servicios internos
# GENERAR: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
API_INTERNAL_SECRET=your-internal-api-secret-key

# ============================================
# BASE DE DATOS
# ============================================

# MongoDB / PostgreSQL / MySQL
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/therianthrope?retryWrites=true&w=majority
# O para PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/therianthrope

# Redis (para caching y session storage)
REDIS_URL=redis://user:password@localhost:6379

# ============================================
# SERVICIOS DE PAGO
# ============================================

# Stripe (procesar pagos)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLIC_KEY=pk_live_your-stripe-public-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Apple In-App Purchases
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Google Play Billing
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# ============================================
# EMAIL Y NOTIFICACIONES
# ============================================

# SendGrid (enviar emails de verificación, alertas)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@therianthrope-dating.com

# SMS (Twilio para verificación por SMS)
TWILIO_ACCOUNT_SID=AC....
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com

# ============================================
# ALMACENAMIENTO DE ARCHIVOS
# ============================================

# AWS S3 (fotos de perfil, contenido media)
AWS_ACCESS_KEY_ID=AKIA....
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=therianthrope-user-media
AWS_S3_FOLDER_PROFILES=/profiles/
AWS_S3_FOLDER_MESSAGES=/messages/

# CloudFlare (CDN para rápida distribución)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id

# ============================================
# ANALYTICS Y LOGGING
# ============================================

# Firebase Analytics
FIREBASE_ANALYTICS_ENABLED=true

# Mixpanel (user behavior analytics)
MIXPANEL_TOKEN=your-mixpanel-token

# Sentry (error tracking)
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_ENVIRONMENT=production

# Datadog (monitoring)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_SITE=datadoghq.com

# ============================================
# SEGURIDAD ADICIONAL
# ============================================

# Rate Limiting
RATE_LIMIT_WINDOW=900000  # 15 minutos en ms
RATE_LIMIT_MAX_REQUESTS=100  # máximo de requests por ventana

# CORS (Cross-Origin Resource Sharing)
CORS_ORIGIN=https://app.therianthrope-dating.com,https://api.therianthrope-dating.com

# Sesiones
SESSION_SECRET=your-session-secret-key-32-characters
SESSION_TIMEOUT=86400000  # 24 horas en ms

# 2FA (Two-Factor Authentication)
TWO_FA_WINDOW=30  # 30 segundos para validar código TOTP
TWO_FA_ENABLED=true

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# ============================================
# LEGAL Y COMPLIANCE
# ============================================

# GDPR
GDPR_ENABLED=true
GDPR_RETENTION_DAYS=30  # Eliminar datos 30 días después de solicitud

# CCPA (California)
CCPA_ENABLED=true
CCPA_RETENTION_YEARS=7  # Retener para impuestos

# Age Verification
MIN_AGE=18
VERIFY_ID_ENABLED=true
VERIFY_FACIAL_ENABLED=false  # Habilitar solo si tienes servicio

# ============================================
# COMUNICACIONES Y CONTACTO LEGAL
# ============================================

COMPANY_NAME=Therianthrope Dating Inc.
COMPANY_EMAIL=contact@therianthrope-dating.com
COMPANY_PHONE=+1-XXX-XXX-XXXX
COMPANY_ADDRESS=123 Main Street, Your City, ST 12345

LEGAL_EMAIL=legal@therianthrope-dating.com
PRIVACY_EMAIL=privacy@therianthrope-dating.com
DPO_EMAIL=dpo@therianthrope-dating.com
SECURITY_EMAIL=security@therianthrope-dating.com

# Privacy Policy URL
PRIVACY_POLICY_URL=https://therianthrope-dating.com/privacy
TERMS_URL=https://therianthrope-dating.com/terms
COMMUNITY_GUIDELINES_URL=https://therianthrope-dating.com/guidelines

# ============================================
# SERVIDOR Y PUERTO
# ============================================

PORT=3000
HOST=0.0.0.0
API_URL=https://api.therianthrope-dating.com
WEB_URL=https://therianthrope-dating.com
MOBILE_APP_URL=therianthrope://

# ============================================
# DESARROLLO Y DEBUG
# ============================================

# Logging
LOG_LEVEL=info  # error, warn, info, debug, trace
LOG_FORMAT=json
LOG_FILE=/var/log/therianthrope/app.log

# Debug mode (NUNCA en producción)
DEBUG=false
DEBUG_SQL=false  # Mostrar queries SQL (security risk)

# ============================================
# MANTENIMIENTO Y BACKUPS
# ============================================

# Backup automático de base de datos
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Cron format: 2 AM diario
BACKUP_RETENTION_DAYS=30

# Monitoreo de uptime
UPTIME_MONITOR_ENABLED=true
UPTIME_CHECK_INTERVAL=300000  # Cada 5 minutos

# ============================================
# INTEGRACIONES EXTERNAS
# ============================================

# Mapbox (geolocalización - OPCIONAL)
MAPBOX_API_TOKEN=your-mapbox-token

# Giphy (stickers en chat - OPCIONAL)
GIPHY_API_KEY=your-giphy-api-key

# ============================================
# MÁQUINA VIRTUAL Y CONTENEDOR
# ============================================

DOCKER_EXPOSED_PORT=3000
DOCKER_NETWORK=therianthrope-network
DOCKER_COMPOSE_VERSION=3.8

# Kubernetes (si usas K8s)
KUBERNETES_NAMESPACE=production
KUBERNETES_REPLICA_COUNT=3

# ============================================
# NOTAS IMPORTANTES
# ============================================

# ⚠️ NUNCA commitear este archivo completo
# ✅ Crear .gitignore con:
#    .env
#    .env.local
#    .env.*.local
#    *.key
#    *.pem
#    service-account.json

# ⚠️ ROTAR SECRETOS regularmente (cada 90 días):
#    - JWT_SECRET
#    - DATABASE_ENCRYPTION_KEY
#    - STRIPE_SECRET_KEY
#    - TODOS los API keys

# ✅ Guardar valores en:
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - HashiCorp Vault
#    - 1Password / LastPass Team

# ✅ Usar variables de environment en CI/CD:
#    - GitHub Actions Secrets
#    - GitLab CI/CD Variables
#    - Jenkins Credentials

# ⚠️ Al actualizar producción:
#    1. Cambiar SECRET en .env
#    2. Revocar tokens anteriores
#    3. Notificar a usuarios que relogueen
#    4. Monitorear logs por errores

# ✅ Auditoría mensual:
#    - Revisar quién accede a variables
#    - Verificar cambios de secretos
#    - Validar permisos de usuario

# 🔐 Encriptación de .env en disco:
#    git-crypt init
#    git-crypt add-user user@example.com
